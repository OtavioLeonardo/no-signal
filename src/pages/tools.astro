---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { AppConfig } from '@/utils/AppConfig';

const { title } = AppConfig;

const toolGroups = [
	{
		category: '赛道工程',
		sub: 'Sim Racing',
		icon: '🏁',
		list: [
			{
				name: 'LMU PitWall',
				description: 'Le Mans Ultimate 策略数据查询与燃油计算工具。',
				url: 'https://otavioleonardo.github.io/lmu-pitwall/',
				tag: 'Web App',
			},
			{
				name: 'Motec Setup Guide',
				description: '基于遥测数据分析的赛车调校速查手册。',
				url: '#',
				tag: 'PDF',
			},
		],
	},
	{
		category: '代码实验',
		sub: 'Dev Labs',
		icon: '🧪',
		list: [
			{
				name: 'Sudoku Solver',
				description: '基于回溯算法的数独求解器。',
				url: '#',
				tag: 'Algo',
			},
			{
				name: 'Zen Clock',
				description: '极简主义时钟应用原型。',
				url: '#',
				tag: 'iOS',
			},
		],
	},
	{
		category: '学习系统',
		sub: 'Learning',
		icon: '📚',
		list: [
			{
				name: 'Deutsch Notizen',
				description: 'A1-B1 德语语法笔记与复习卡片。',
				url: '#',
				tag: 'Notes',
			},
		],
	},
];
---

<Base head={{ title: `数字工坊 - ${title}`, description: 'Tools and systems I build/use' }}>
	<Section>
		<div class="space-y-6 py-8 md:py-10">
			<header class="panel p-6 md:p-8">
				<p class="kicker">Tooling Workspace</p>
				<h1 class="mt-2 text-3xl font-bold md:text-5xl">数字工坊</h1>
				<p class="mt-3 max-w-3xl text-sm leading-7 text-[color:var(--text-muted)] md:text-base">
					围绕写作、赛车、学习和工程实践搭建的小工具库。每个工具都服务于真实任务，而不是展示技术栈。
				</p>
			</header>

			<div class="space-y-5">
				{
					toolGroups.map((group) => (
						<section class="panel p-5">
							<div class="mb-4 flex items-end justify-between section-rule">
								<div class="flex items-center gap-3">
									<span class="text-xl">{group.icon}</span>
									<div>
										<h2 class="text-xl font-semibold">{group.category}</h2>
										<p class="text-xs uppercase tracking-[0.16em] text-[color:var(--text-muted)]">{group.sub}</p>
									</div>
								</div>
							</div>
							<div class="grid gap-3 md:grid-cols-2">
								{
									group.list.map((tool) => (
										<a
											href={tool.url}
											target={tool.url.startsWith('http') ? '_blank' : '_self'}
											class="rounded-lg border border-[var(--border)] bg-[color:var(--panel-strong)] p-4 hover:border-[color:var(--accent-2)]"
										>
											<div class="mb-2 flex items-center justify-between gap-2">
												<h3 class="text-base font-semibold text-[color:var(--text)]">{tool.name}</h3>
												<span class="rounded-md border border-[var(--border)] px-1.5 py-0.5 text-[10px] text-[color:var(--text-muted)]">
													{tool.tag}
												</span>
											</div>
											<p class="text-sm leading-7 text-[color:var(--text-muted)]">{tool.description}</p>
										</a>
									))
								}
							</div>
						</section>
					))
				}
			</div>
		</div>
	</Section>
</Base>
