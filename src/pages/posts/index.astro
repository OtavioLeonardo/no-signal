---
import { AppConfig } from '@/utils/AppConfig';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const { title, description } = AppConfig;

const allPosts = (await getCollection('posts')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const groupedPosts = allPosts.reduce(
	(acc, post) => {
		const year = new Date(post.data.pubDate).getFullYear().toString();
		if (!acc[year]) acc[year] = [];
		acc[year].push(post);
		return acc;
	},
	{} as Record<string, CollectionEntry<'posts'>[]>,
);
const years = Object.keys(groupedPosts).sort((a, b) => Number(b) - Number(a));

const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];
---

<Base head={{ title: `归档 - ${title}`, description }}>
	<Section>
		<div class="space-y-6 py-8 md:py-10">
			<header class="panel p-6 md:p-8">
				<p class="kicker">Archive</p>
				<h1 class="mt-2 text-3xl font-bold md:text-5xl">创作归档</h1>
				<p class="mt-3 max-w-3xl text-sm leading-7 text-[color:var(--text-muted)] md:text-base">
					把散落的文章按时间和主题组织成可追踪的知识路径。你可以按关键词快速检索，也可以按年度回看思路如何演化。
				</p>
				<div class="mt-5 grid gap-3 sm:grid-cols-3">
					<div class="panel-soft p-3">
						<p class="kicker">Total Posts</p>
						<p class="mt-1 text-2xl font-semibold">{allPosts.length}</p>
					</div>
					<div class="panel-soft p-3">
						<p class="kicker">Years</p>
						<p class="mt-1 text-2xl font-semibold">{years.length}</p>
					</div>
					<div class="panel-soft p-3">
						<p class="kicker">Tags</p>
						<p class="mt-1 text-2xl font-semibold">{uniqueTags.length}</p>
					</div>
				</div>
			</header>

			<div class="panel p-4 md:p-5">
				<div class="grid gap-3 md:grid-cols-[1.4fr_1fr]">
					<input
						id="archive-search"
						type="search"
						placeholder="搜索标题或描述（按 / 聚焦）"
						class="rounded-lg border border-[var(--border)] bg-[color:var(--panel-strong)] px-3 py-2.5 text-sm outline-none focus:border-[color:var(--accent-2)]"
					/>
					<select
						id="archive-year-filter"
						class="rounded-lg border border-[var(--border)] bg-[color:var(--panel-strong)] px-3 py-2.5 text-sm outline-none focus:border-[color:var(--accent-2)]"
					>
						<option value="all">所有年份</option>
						{years.map((year) => <option value={year}>{year} 年</option>)}
					</select>
				</div>
			</div>

			<div class="grid items-start gap-6 lg:grid-cols-[220px_1fr]">
				<aside class="panel sticky top-24 hidden p-4 lg:block">
					<p class="kicker mb-3">年份导航</p>
					<ul class="space-y-1 text-sm">
						{
							years.map((year) => (
								<li>
									<a
										href={`#year-${year}`}
										class="flex items-center justify-between rounded-md px-2 py-1.5 text-[color:var(--text-muted)] hover:bg-[color:var(--panel-strong)] hover:text-[color:var(--text)]"
									>
										<span>{year}</span>
										<span class="font-mono text-xs">{groupedPosts[year]?.length || 0}</span>
									</a>
								</li>
							))
						}
					</ul>
				</aside>

				<main class="space-y-5">
					{
						years.map((year) => (
							<section id={`year-${year}`} data-year-section={year} class="panel p-5">
								<div class="mb-4 flex items-center justify-between border-b border-[var(--border)] pb-3">
									<h2 class="text-2xl font-semibold">{year}</h2>
									<span class="text-xs text-[color:var(--text-muted)]">
										共 {groupedPosts[year]?.length || 0} 篇
									</span>
								</div>
								<div class="space-y-1.5">
									{groupedPosts[year]!.map((post) => (
										<a
											href={`/posts/${post.slug}`}
											data-archive-item
											data-year={year}
											data-title={post.data.title.toLowerCase()}
											data-description={(post.data.description || '').toLowerCase()}
											class="grid gap-2 rounded-lg border border-transparent px-3 py-3 hover:border-[var(--border)] hover:bg-[color:var(--panel-strong)] md:grid-cols-[120px_1fr_auto]"
										>
											<span class="text-xs font-mono text-[color:var(--text-muted)]">
												{new Date(post.data.pubDate).toISOString().slice(0, 10)}
											</span>
											<div class="min-w-0">
												<p class="truncate text-sm font-semibold text-[color:var(--text)]">{post.data.title}</p>
												<p class="mt-1 line-clamp-1 text-xs text-[color:var(--text-muted)]">{post.data.description}</p>
											</div>
											<div class="hidden items-center gap-1 md:flex">
												{post.data.tags.slice(0, 2).map((tag) => (
													<span class="rounded-md border border-[var(--border)] px-1.5 py-0.5 text-[10px] text-[color:var(--text-muted)]">
														#{tag}
													</span>
												))}
											</div>
										</a>
									))}
								</div>
							</section>
						))
					}
				</main>
			</div>
		</div>
	</Section>

	<script is:inline>
		const initArchiveFilters = () => {
			const searchInput = document.getElementById('archive-search');
			const yearFilter = document.getElementById('archive-year-filter');
			if (!(searchInput instanceof HTMLInputElement) || !(yearFilter instanceof HTMLSelectElement) || searchInput.dataset.bound === '1') return;

			searchInput.dataset.bound = '1';
			const items = Array.from(document.querySelectorAll('[data-archive-item]'));
			const yearSections = Array.from(document.querySelectorAll('[data-year-section]'));

			const applyFilters = () => {
				const keyword = searchInput.value.trim().toLowerCase();
				const year = yearFilter.value;

				items.forEach((item) => {
					if (!(item instanceof HTMLElement)) return;
					const title = item.dataset.title || '';
					const description = item.dataset.description || '';
					const itemYear = item.dataset.year || '';
					const keywordMatched = !keyword || title.includes(keyword) || description.includes(keyword);
					const yearMatched = year === 'all' || itemYear === year;
					item.classList.toggle('hidden', !(keywordMatched && yearMatched));
				});

				yearSections.forEach((section) => {
					if (!(section instanceof HTMLElement)) return;
					const visible = Array.from(section.querySelectorAll('[data-archive-item]')).some(
						(item) => !(item instanceof HTMLElement ? item.classList.contains('hidden') : true),
					);
					section.classList.toggle('hidden', !visible);
				});
			};

			[searchInput, yearFilter].forEach((element) => {
				element.addEventListener('input', applyFilters);
				element.addEventListener('change', applyFilters);
			});

			window.addEventListener('keydown', (event) => {
				const activeTag = document.activeElement ? document.activeElement.tagName : '';
				if (event.key === '/' && activeTag !== 'INPUT' && activeTag !== 'TEXTAREA') {
					event.preventDefault();
					searchInput.focus();
				}
			});
		};

		document.addEventListener('astro:page-load', initArchiveFilters);
	</script>
</Base>
