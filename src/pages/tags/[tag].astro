---
import { AppConfig } from '@/utils/AppConfig';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
	const allPosts = await getCollection('posts');
	const allTags = new Set<string>();
	allPosts.forEach((post) => {
		post.data.tags?.forEach((tag) => allTags.add(tag));
	});

	return [...allTags].map((tag) => {
		const filteredPosts = allPosts
			.filter((post) => post.data.tags?.includes(tag))
			.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		return {
			params: { tag },
			props: { posts: filteredPosts },
		};
	});
}

interface Props {
	posts: CollectionEntry<'posts'>[];
}

const { tag } = Astro.params;
const { posts } = Astro.props as Props;
const { title } = AppConfig;

const latestDate = posts[0] ? new Date(posts[0].data.pubDate).toISOString().slice(0, 10) : '--';
---

<Base head={{ title: `#${tag} - ${title}`, description: `Posts tagged with ${tag}` }}>
	<Section>
		<div class="space-y-6 py-8 md:py-10">
			<header class="panel p-6 md:p-8">
				<p class="kicker">Tag Detail</p>
				<h1 class="mt-2 text-3xl font-bold md:text-5xl">#{tag}</h1>
				<p class="mt-3 text-sm leading-7 text-[color:var(--text-muted)] md:text-base">
					这里汇总与「{tag}」相关的全部文章，便于你在同一主题下进行纵向回看。
				</p>
				<div class="mt-5 grid gap-3 sm:grid-cols-3">
					<div class="panel-soft p-3">
						<p class="kicker">Articles</p>
						<p class="mt-1 text-2xl font-semibold">{posts.length}</p>
					</div>
					<div class="panel-soft p-3">
						<p class="kicker">Latest Update</p>
						<p class="mt-1 text-lg font-semibold">{latestDate}</p>
					</div>
					<div class="panel-soft p-3">
						<p class="kicker">Back</p>
						<a href="/tags" class="mt-1 inline-flex text-sm text-[color:var(--text-muted)] hover:text-[color:var(--text)]">
							返回标签索引 →
						</a>
					</div>
				</div>
			</header>

			<section class="panel p-5">
				<div class="space-y-2">
					{
						posts.map((post) => (
							<a
								href={`/posts/${post.slug}/`}
								class="grid gap-2 rounded-lg border border-transparent px-3 py-3 hover:border-[var(--border)] hover:bg-[color:var(--panel-strong)] md:grid-cols-[120px_1fr_auto]"
							>
								<span class="text-xs font-mono text-[color:var(--text-muted)]">
									{new Date(post.data.pubDate).toISOString().slice(0, 10)}
								</span>
								<div class="min-w-0">
									<p class="truncate text-sm font-semibold text-[color:var(--text)]">{post.data.title}</p>
									<p class="mt-1 line-clamp-1 text-xs text-[color:var(--text-muted)]">{post.data.description}</p>
								</div>
								<div class="hidden items-center gap-1 md:flex">
									{post.data.tags.filter((value) => value !== tag).slice(0, 2).map((item) => (
										<span class="rounded-md border border-[var(--border)] px-1.5 py-0.5 text-[10px] text-[color:var(--text-muted)]">
											#{item}
										</span>
									))}
								</div>
							</a>
						))
					}
				</div>
			</section>
		</div>
	</Section>
</Base>
