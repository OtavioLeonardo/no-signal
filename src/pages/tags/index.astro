---
import Section from '@/components/Section.astro';
import Base from '@/layouts/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { getCollection } from 'astro:content';

const { title, description } = AppConfig;
const allPosts = await getCollection('posts');

const tagMap: Record<string, number> = {};
allPosts.forEach((post) => {
	post.data.tags?.forEach((tag) => {
		tagMap[tag] = (tagMap[tag] || 0) + 1;
	});
});

const sortedTags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);
const maxCount = sortedTags[0]?.[1] || 1;
---

<Base head={{ title: `灵感索引 - ${title}`, description }}>
	<Section>
		<div class="space-y-6 py-8 md:py-10">
			<header class="panel p-6 md:p-8">
				<p class="kicker">Topic Index</p>
				<h1 class="mt-2 text-3xl font-bold md:text-5xl">灵感索引</h1>
				<p class="mt-3 max-w-3xl text-sm leading-7 text-[color:var(--text-muted)] md:text-base">
					标签是你知识网络的节点。这里展示每个主题的覆盖深度，帮你快速找到高频思考点和潜在空白区。
				</p>
				<div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					<div class="panel-soft p-3">
						<p class="kicker">Tag Count</p>
						<p class="mt-1 text-2xl font-semibold">{sortedTags.length}</p>
					</div>
					<div class="panel-soft p-3">
						<p class="kicker">Top Tag</p>
						<p class="mt-1 truncate text-lg font-semibold">{sortedTags[0]?.[0] || '-'}</p>
					</div>
					<div class="panel-soft p-3">
						<p class="kicker">Top Coverage</p>
						<p class="mt-1 text-2xl font-semibold">{sortedTags[0]?.[1] || 0}</p>
					</div>
					<div class="panel-soft p-3">
						<p class="kicker">Total Posts</p>
						<p class="mt-1 text-2xl font-semibold">{allPosts.length}</p>
					</div>
				</div>
			</header>

			<div class="panel p-4 md:p-5">
				<input
					id="tag-search-input"
					type="search"
					placeholder="筛选标签（按 / 聚焦）"
					class="w-full rounded-lg border border-[var(--border)] bg-[color:var(--panel-strong)] px-3 py-2.5 text-sm outline-none focus:border-[color:var(--accent-2)]"
				/>
			</div>

			<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
				{
					sortedTags.map(([tag, count]) => (
						<a
							href={`/tags/${tag}`}
							data-tag-card
							data-tag-name={tag.toLowerCase()}
							class="panel p-4 hover:border-[color:var(--accent-2)]"
						>
							<div class="flex items-center justify-between">
								<h2 class="truncate text-lg font-semibold text-[color:var(--text)]">#{tag}</h2>
								<span class="rounded-md border border-[var(--border)] bg-[color:var(--panel-strong)] px-2 py-1 text-xs text-[color:var(--text-muted)]">
									{count}
								</span>
							</div>
							<div class="mt-3 h-1.5 rounded-full bg-[color:var(--panel-strong)]">
								<div
									class="h-1.5 rounded-full bg-[color:var(--accent)]"
									style={`width:${Math.max(8, Math.round((count / maxCount) * 100))}%`}
								></div>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</Section>

	<script is:inline>
		const initTagFilter = () => {
			const input = document.getElementById('tag-search-input');
			if (!(input instanceof HTMLInputElement) || input.dataset.bound === '1') return;
			input.dataset.bound = '1';

			const cards = Array.from(document.querySelectorAll('[data-tag-card]'));
			const applyFilter = () => {
				const keyword = input.value.trim().toLowerCase();
				cards.forEach((card) => {
					if (!(card instanceof HTMLElement)) return;
					const name = card.dataset.tagName || '';
					card.classList.toggle('hidden', Boolean(keyword) && !name.includes(keyword));
				});
			};

			input.addEventListener('input', applyFilter);
			window.addEventListener('keydown', (event) => {
				const activeTag = document.activeElement ? document.activeElement.tagName : '';
				if (event.key === '/' && activeTag !== 'INPUT' && activeTag !== 'TEXTAREA') {
					event.preventDefault();
					input.focus();
				}
			});
		};

		document.addEventListener('astro:page-load', initTagFilter);
	</script>
</Base>
