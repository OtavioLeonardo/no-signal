---
import { AppConfig } from "@/utils/AppConfig";
import Base from "@/layouts/Base.astro";
import Section from "@/components/Section.astro";
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";

const { title, description } = AppConfig;

const allPosts = (await getCollection("posts")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allDiary = (await getCollection("diary")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = allPosts.find((post) => post.data.isPinned) || allPosts[0];
const recentPosts = featuredPost
	? allPosts.filter((post) => post.slug !== featuredPost.slug).slice(0, 8)
	: allPosts.slice(0, 8);
const latestDiary = allDiary.slice(0, 6);

const yearSet = new Set(
	allPosts.map((post) => new Date(post.data.pubDate).getFullYear()),
);
const oldestPost = allPosts.length ? allPosts[allPosts.length - 1] : undefined;
const firstPostYear = oldestPost
	? new Date(oldestPost.data.pubDate).getFullYear()
	: new Date().getFullYear();

const tagMap = new Map<string, number>();
for (const post of allPosts) {
	for (const tag of post.data.tags || []) {
		tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
	}
}
const topTags = [...tagMap.entries()].sort((a, b) => b[1] - a[1]).slice(0, 9);
const maxTagCount = topTags[0]?.[1] || 1;

const nowPage = await getEntry("pages", "now");
const nowTitle = nowPage?.data?.title || "Now";
let nowUpdatedText = "未更新";
if (nowPage) {
	nowUpdatedText = new Date(nowPage.data.updatedDate).toLocaleDateString(
		"zh-CN",
	);
}

const signalMap = Array.from({ length: 98 }, (_, index) => {
	const date = new Date();
	date.setDate(date.getDate() - (97 - index));
	const dateText = date.toISOString().slice(0, 10);
	const hasPost = allPosts.some(
		(post) => post.data.pubDate.toISOString().slice(0, 10) === dateText,
	);
	const hasDiary = allDiary.some(
		(entry) => entry.data.pubDate.toISOString().slice(0, 10) === dateText,
	);
	return {
		date: dateText,
		level: hasPost && hasDiary ? 3 : hasPost || hasDiary ? 2 : 0,
	};
});
---

<Base head={{ title, description }}>
	<Section>
		<div class="space-y-8 py-8 md:space-y-10 md:py-10">
			<header class="panel p-6 md:p-8">
				<p class="kicker">Knowledge Operating System</p>
				<div class="mt-3 grid gap-6 lg:grid-cols-[1.25fr_1fr]">
					<div>
						<h1
							class="text-3xl font-bold leading-tight md:text-5xl"
						>
							一个用于长期思考、持续积累与反复迭代的个人知识场
						</h1>
						<p
							class="mt-4 max-w-3xl text-sm leading-7 text-[color:var(--text-muted)] md:text-base"
						>
							这里不是“作品橱窗”，而是你的思考中枢。把赛车、音乐、阅读、技术、生活反思全都接入同一套笔记系统，
							通过持续回看和重写，形成真正可复利的认知资产。
						</p>
					</div>
					<div class="grid gap-3 sm:grid-cols-2">
						<div class="panel-soft p-4">
							<p class="kicker">文章总数</p>
							<p class="mt-2 text-2xl font-semibold">
								{allPosts.length}
							</p>
						</div>
						<div class="panel-soft p-4">
							<p class="kicker">日记条目</p>
							<p class="mt-2 text-2xl font-semibold">
								{allDiary.length}
							</p>
						</div>
						<div class="panel-soft p-4">
							<p class="kicker">活跃年份</p>
							<p class="mt-2 text-2xl font-semibold">
								{yearSet.size}
							</p>
						</div>
						<div class="panel-soft p-4">
							<p class="kicker">起始年份</p>
							<p class="mt-2 text-2xl font-semibold">
								{firstPostYear}
							</p>
						</div>
					</div>
				</div>
			</header>

			<div id="home-top-grid" class="grid gap-6 lg:grid-cols-12">
				<div class="lg:col-span-7">
					{
						featuredPost ? (
							<a href={`/posts/${featuredPost.slug}/`} class="group block">
								<article
									id="home-featured-card"
									class="panel overflow-hidden"
								>
									<div class="relative aspect-[21/9] border-b border-[var(--border)]">
										{featuredPost.data.image?.src ? (
											<Image
												src={
													featuredPost.data.image.src
												}
												alt={
													featuredPost.data.image
														.alt ||
													featuredPost.data.title
												}
												class="h-full w-full object-cover"
												width={1280}
												height={800}
											/>
										) : (
											<div class="h-full w-full bg-[color:var(--panel-strong)]" />
										)}
										<div class="absolute left-4 top-4 rounded-md border border-[var(--border)] bg-[color:var(--panel)] px-2 py-1 text-[11px] uppercase tracking-[0.16em] text-[color:var(--text-muted)]">
											Featured
										</div>
									</div>
									<div class="p-5 md:p-6">
										<p class="text-xs font-mono text-[color:var(--text-muted)]">
											{new Date(
												featuredPost.data.pubDate,
											).toLocaleDateString("zh-CN")}
										</p>
										<h2 class="mt-2 text-2xl font-semibold text-[color:var(--text)] group-hover:text-[color:var(--accent)]">
											{featuredPost.data.title}
										</h2>
										<p class="mt-3 line-clamp-3 text-sm leading-7 text-[color:var(--text-muted)]">
											{featuredPost.data.description}
										</p>
									</div>
								</article>
							</a>
						) : (
							<div class="panel p-6 text-sm text-[color:var(--text-muted)]">
								暂无文章内容
							</div>
						)
					}
				</div>

				<div
					id="home-right-rail"
					class="space-y-6 lg:col-span-5 lg:flex lg:flex-col"
				>
					<article class="panel p-5 lg:min-h-0 lg:flex-1">
						<div class="mb-3 flex items-center justify-between">
							<p class="kicker">Now</p>
							<span
								class="rounded-md border border-[var(--border)] bg-[color:var(--panel-strong)] px-2 py-1 text-[11px] text-[color:var(--text-muted)]"
							>
								更新于 {nowUpdatedText}
							</span>
						</div>
						<div class="flex h-full flex-col justify-between gap-4">
							<div class="space-y-2">
								<p
									class="text-lg font-semibold text-[color:var(--text)]"
								>
									{nowTitle}
								</p>
								<p
									class="text-sm leading-7 text-[color:var(--text-muted)]"
								>
									专注于你要做的事，无论这件事到底有没有用。
								</p>
							</div>
							<a
								href="/now"
								class="inline-flex items-center justify-center rounded-md border border-[var(--border)] bg-[color:var(--panel-strong)] px-3 py-2 text-sm font-medium text-[color:var(--text-muted)] hover:text-[color:var(--text)]"
							>
								打开 Now 页面 →
							</a>
						</div>
					</article>

					<article class="panel p-5 lg:shrink-0">
						<div class="mb-3 flex items-center justify-between">
							<p class="kicker">Signal Graph</p>
							<span class="text-xs text-[color:var(--text-muted)]"
								>近 14 周</span
							>
						</div>
						<div
							class="grid gap-1"
							style="grid-template-columns: repeat(14, minmax(0, 1fr));"
						>
							{
								signalMap.map((item) => (
									<div
										class:list={[
											"h-3 rounded-sm border border-black/5 dark:border-white/5",
											item.level === 3
												? "bg-[color:var(--accent)]"
												: item.level === 2
													? "bg-[color:var(--accent-2)]"
													: "bg-[color:var(--panel-strong)]",
										]}
										title={item.date}
									/>
								))
							}
						</div>
						<div
							class="mt-3 flex items-center gap-4 text-[11px] text-[color:var(--text-muted)]"
						>
							<span class="inline-flex items-center gap-1"
								><i
									class="inline-block h-2 w-2 rounded-sm bg-[color:var(--accent)]"
								></i>文章+日记</span
							>
							<span class="inline-flex items-center gap-1"
								><i
									class="inline-block h-2 w-2 rounded-sm bg-[color:var(--accent-2)]"
								></i>单条记录</span
							>
						</div>
					</article>
				</div>
			</div>

			<div class="grid gap-6 lg:grid-cols-12">
				<section class="panel p-5 lg:col-span-8">
					<div class="mb-4 section-rule">
						<div class="flex items-center justify-between gap-3">
							<h2 class="text-xl font-semibold">近期文章</h2>
							<a
								href="/posts"
								class="shrink-0 text-sm text-[color:var(--text-muted)] hover:text-[color:var(--text)]"
								>查看全部 →</a
							>
						</div>
					</div>
					<div class="space-y-2">
						{
							recentPosts.length ? (
								recentPosts.map((post) => (
									<a
										href={`/posts/${post.slug}/`}
										class="grid gap-2 rounded-lg border border-transparent px-3 py-3 hover:border-[var(--border)] hover:bg-[color:var(--panel-strong)] md:grid-cols-[130px_1fr_auto]"
									>
										<span class="text-xs font-mono text-[color:var(--text-muted)]">
											{new Date(post.data.pubDate)
												.toISOString()
												.slice(0, 10)}
										</span>
										<div class="min-w-0">
											<p class="truncate text-sm font-semibold text-[color:var(--text)]">
												{post.data.title}
											</p>
											<p class="mt-1 line-clamp-1 text-xs text-[color:var(--text-muted)]">
												{post.data.description}
											</p>
										</div>
										<span class="hidden text-xs text-[color:var(--text-muted)] md:inline">
											open
										</span>
									</a>
								))
							) : (
								<p class="text-sm text-[color:var(--text-muted)]">
									暂无近期文章。
								</p>
							)
						}
					</div>
				</section>

				<section class="panel p-5 lg:col-span-4">
					<div class="mb-4 section-rule">
						<h2 class="text-xl font-semibold">主题分布</h2>
					</div>
					<ul class="space-y-2">
						{
							topTags.map(([tag, count]) => (
								<li>
									<a
										href={`/tags/${tag}`}
										class="block rounded-lg px-2 py-2 hover:bg-[color:var(--panel-strong)]"
									>
										<div class="mb-1 flex items-center justify-between text-xs text-[color:var(--text-muted)]">
											<span>#{tag}</span>
											<span>{count}</span>
										</div>
										<div class="h-1.5 rounded-full bg-[color:var(--panel-strong)]">
											<div
												class="h-1.5 rounded-full bg-[color:var(--accent-2)]"
												style={`width:${Math.max(10, Math.round((count / maxTagCount) * 100))}%`}
											/>
										</div>
									</a>
								</li>
							))
						}
					</ul>
				</section>
			</div>

			<section class="panel p-5">
				<div class="mb-4 section-rule">
					<div class="flex items-center justify-between gap-3">
						<h2 class="text-xl font-semibold">最新日记</h2>
						<a
							href="/diary"
							class="shrink-0 text-sm text-[color:var(--text-muted)] hover:text-[color:var(--text)]"
							>进入 Diary Hub →</a
						>
					</div>
				</div>
				<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
					{
						latestDiary.map((entry) => (
							<a
								href={`/diary/${entry.slug}`}
								class="rounded-lg border border-[var(--border)] bg-[color:var(--panel-strong)] p-4 hover:border-[color:var(--accent)]"
							>
								<p class="text-xs font-mono text-[color:var(--text-muted)]">
									{new Date(entry.data.pubDate)
										.toISOString()
										.slice(0, 10)}
								</p>
								<h3 class="mt-2 line-clamp-2 text-base font-semibold text-[color:var(--text)]">
									{entry.data.title}
								</h3>
								<p class="mt-1 line-clamp-2 text-xs leading-6 text-[color:var(--text-muted)]">
									{entry.data.description || "无摘要"}
								</p>
							</a>
						))
					}
				</div>
			</section>
		</div>
	</Section>

	<script is:inline>
		const initHomeTopRail = () => {
			const featured = document.getElementById("home-featured-card");
			const rightRail = document.getElementById("home-right-rail");
			if (
				!(featured instanceof HTMLElement) ||
				!(rightRail instanceof HTMLElement)
			)
				return;

			const syncHeight = () => {
				if (window.innerWidth < 1024) {
					rightRail.style.removeProperty("height");
					return;
				}
				rightRail.style.height = `${featured.getBoundingClientRect().height}px`;
			};

			syncHeight();
			const observer = new ResizeObserver(syncHeight);
			observer.observe(featured);
			window.addEventListener("resize", syncHeight);

			document.addEventListener(
				"astro:before-swap",
				() => {
					observer.disconnect();
					window.removeEventListener("resize", syncHeight);
				},
				{ once: true },
			);
		};

		document.addEventListener("astro:page-load", initHomeTopRail);
	</script>
</Base>
