---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
---

<Base head={{ title: 'Search', description: 'Search my digital garden' }}>
	<Section>
		<div class="mx-auto max-w-4xl space-y-6 py-8 md:py-10">
			<header class="panel p-6 md:p-8">
				<p class="kicker">Search Console</p>
				<h1 class="mt-2 text-3xl font-bold md:text-5xl">研究检索</h1>
				<p class="mt-3 max-w-2xl text-sm leading-7 text-[color:var(--text-muted)] md:text-base">
					按关键词检索全站文章与页面。适合快速找回某个概念、案例、论证或过往结论。
				</p>
			</header>

			<div class="panel p-5">
				<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
				<div id="search"></div>
			</div>
		</div>
	</Section>
</Base>

<style is:global>
	:root {
		--pagefind-ui-scale: 1;
		--pagefind-ui-primary: color-mix(in oklch, var(--accent-2) 85%, black);
		--pagefind-ui-text: var(--text);
		--pagefind-ui-background: transparent;
		--pagefind-ui-border: var(--border);
		--pagefind-ui-tag: color-mix(in oklch, var(--panel-strong) 85%, transparent);
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 0.55rem;
		--pagefind-ui-font: 'IBM Plex Sans SC', sans-serif;
	}

	.pagefind-ui__search-input {
		border-radius: 0.65rem !important;
		border-color: var(--pagefind-ui-border) !important;
		background: color-mix(in oklch, var(--panel-strong) 90%, transparent) !important;
		padding: 12px 14px !important;
	}

	.pagefind-ui__search-input:focus {
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent-2) 25%, transparent) !important;
	}

	.pagefind-ui__result {
		border: none !important;
		border-radius: 0.7rem !important;
		padding: 0.85rem !important;
	}

	.pagefind-ui__result:hover {
		background: color-mix(in oklch, var(--panel-strong) 75%, transparent) !important;
	}

	.pagefind-ui__result-title {
		font-size: 1.02rem !important;
		font-weight: 600 !important;
		color: var(--text) !important;
	}

	.pagefind-ui__result-excerpt {
		color: var(--text-muted) !important;
		font-size: 0.92rem !important;
	}
</style>

<script>
	document.addEventListener('astro:page-load', async () => {
		const searchDiv = document.querySelector('#search');
		if (!searchDiv) return;
		searchDiv.innerHTML = '';

		try {
			const { PagefindUI } = await import('@pagefind/default-ui');
			new PagefindUI({
				element: '#search',
				showSubResults: true,
				showImages: false,
				resetStyles: false,
				debounceTimeoutMs: 380,
			});
		} catch (error) {
			console.error('Failed to load Pagefind UI:', error);
		}
	});
</script>
