---
interface Props {
	tag: string;
	withHref?: boolean;
}

const { tag, withHref } = Astro.props;

const baseClass =
	'inline-flex items-center rounded-md border px-2 py-1 text-[11px] font-medium tracking-wide transition-colors';
const withHrefClass =
	'border-[var(--border)] bg-[color:var(--panel)] text-[color:var(--text-muted)] hover:text-[color:var(--text)] hover:border-[color:var(--accent-2)]';
const noHrefClass = 'border-[var(--border)] bg-[color:var(--panel)] text-[color:var(--text-muted)]';
---

{
    withHref ? (
        <a
            href={`/tags/${tag}`}
            class={`${baseClass} ${withHrefClass} mr-1.5 mb-1.5`}
        >
            #{tag}
        </a>
    ) : (
        <span class={`${baseClass} ${noHrefClass} mr-1.5 mb-1.5`}>
             #{tag}
        </span>
    )
}
