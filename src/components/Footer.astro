---
import Section from './Section.astro';
const year = new Date().getFullYear();
---

<Section>
	<footer class="mt-14 border-t border-[var(--border)] py-10">
		<div class="grid gap-8 md:grid-cols-[1.4fr_1fr_1fr]">
			<div>
				<p class="kicker">No Signal</p>
				<h3 class="mt-2 text-xl font-semibold text-[color:var(--text)]">个人知识工坊</h3>
				<p class="mt-3 max-w-xl text-sm leading-relaxed text-[color:var(--text-muted)]">
					这里用来打磨观点、记录实验、沉淀系统化思考。内容覆盖赛车、音乐、写作、认知与工具实践。
				</p>
			</div>

			<div>
				<p class="kicker">Explore</p>
				<ul class="mt-3 space-y-2 text-sm text-[color:var(--text-muted)]">
					<li><a class="hover:text-[color:var(--text)]" href="/posts">Posts</a></li>
					<li><a class="hover:text-[color:var(--text)]" href="/diary">Diary</a></li>
					<li><a class="hover:text-[color:var(--text)]" href="/tags">Tags</a></li>
					<li><a class="hover:text-[color:var(--text)]" href="/research">Search</a></li>
				</ul>
			</div>

			<div>
				<p class="kicker">System</p>
				<ul class="mt-3 space-y-2 text-sm text-[color:var(--text-muted)]">
					<li><a class="hover:text-[color:var(--text)]" href="/rss.xml">RSS</a></li>
					<li><a class="hover:text-[color:var(--text)]" href="/sitemap-index.xml">Sitemap</a></li>
					<li><a class="hover:text-[color:var(--text)]" href="/imprint/">Imprint</a></li>
				</ul>
			</div>
		</div>

		<div class="mt-8 border-t border-[var(--border)] pt-4 text-xs text-[color:var(--text-muted)]">
			© {year} no.signal · Built for long-term thinking
		</div>
	</footer>
</Section>
