---
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props as Props;
const toc = headings.filter((heading) => heading.depth > 1 && heading.depth < 4);
---

<nav class="panel max-h-[calc(100vh-7.5rem)] overflow-y-auto p-4">
	<h2 class="kicker mb-3">On This Page</h2>
	<ul class="space-y-1 text-sm">
		{
			toc.map((heading) => (
				<li>
					<a
						href={`#${heading.slug}`}
						class:list={[
							'toc-link block rounded-md px-2 py-1 text-[color:var(--text-muted)] hover:bg-[color:var(--panel-strong)] hover:text-[color:var(--text)]',
							heading.depth === 3 ? 'ml-3 text-xs' : '',
						]}
					>
						{heading.text}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	const initTocObserver = () => {
		const headingNodes = Array.from(document.querySelectorAll('article h2[id], article h3[id]'));
		if (!headingNodes.length) return;

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const id = entry.target.getAttribute('id');
					if (!id || !entry.isIntersecting) return;
					document.querySelectorAll('.toc-link').forEach((link) => {
						link.classList.remove('bg-[color:var(--panel-strong)]', 'text-[color:var(--text)]');
					});
					const activeLink = document.querySelector(`.toc-link[href="#${id}"]`);
					activeLink?.classList.add('bg-[color:var(--panel-strong)]', 'text-[color:var(--text)]');
				});
			},
			{ rootMargin: '-120px 0px -62% 0px' },
		);

		headingNodes.forEach((node) => observer.observe(node));
	};

	document.addEventListener('astro:page-load', initTocObserver);
</script>
