---
import Section from './Section.astro';

const pathname = Astro.url.pathname;
const navItems = [
	{ label: 'Posts', href: '/posts' },
	{ label: 'Diary', href: '/diary' },
	{ label: 'Tags', href: '/tags' },
	{ label: 'Tools', href: '/tools' },
	{ label: 'Search', href: '/research' },
];

const isActive = (href: string) => {
	if (href === '/') return pathname === '/';
	return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="sticky top-0 z-50 border-b border-[var(--border)] bg-[color:var(--bg-soft)]">
	<Section>
		<div class="flex h-16 items-center justify-between gap-4">
			<a href="/" class="group inline-flex min-w-0 items-center gap-3">
				<img src="/nobg.png" alt="No Signal Logo" class="h-8 w-auto rounded-md ring-1 ring-black/10 dark:ring-white/10" />
				<div class="min-w-0">
					<p class="truncate text-sm font-semibold tracking-wide text-[color:var(--text)]">no.signal</p>
					<p class="truncate text-[10px] uppercase tracking-[0.24em] text-[color:var(--text-muted)]">Field Notes Engine</p>
				</div>
			</a>

			<div class="hidden items-center gap-5 md:flex">
				<nav>
					<ul class="flex items-center gap-1 text-sm">
						{
							navItems.map((item) => (
								<li>
									<a
										href={item.href}
										class:list={[
											'rounded-md px-3 py-2 font-medium',
											isActive(item.href)
												? 'bg-[color:var(--panel-strong)] text-[color:var(--text)]'
												: 'text-[color:var(--text-muted)] hover:bg-[color:var(--panel)] hover:text-[color:var(--text)]',
										]}
									>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<div class="h-5 w-px bg-[var(--border)]"></div>

				<div class="inline-flex items-center gap-2">
					<input type="checkbox" id="light-switch-desktop" class="light-switch sr-only" />
					<label
						for="light-switch-desktop"
						class="inline-flex cursor-pointer items-center rounded-md border border-[var(--border)] bg-[color:var(--panel)] px-2.5 py-1.5 text-xs font-medium text-[color:var(--text-muted)] hover:text-[color:var(--text)]"
					>
						Theme
					</label>
				</div>
			</div>

			<button
				id="mobile-menu-button"
				class="inline-flex rounded-md border border-[var(--border)] bg-[color:var(--panel)] p-2 text-[color:var(--text)] md:hidden"
				aria-label="Toggle mobile menu"
				aria-expanded="false"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
		</div>

		<div id="mobile-menu" class="mb-4 hidden rounded-xl border border-[var(--border)] bg-[color:var(--panel)] p-2 md:hidden">
			<nav class="flex flex-col gap-1 text-sm">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							class:list={[
								'rounded-md px-3 py-2 font-medium',
								isActive(item.href)
									? 'bg-[color:var(--panel-strong)] text-[color:var(--text)]'
									: 'text-[color:var(--text-muted)] hover:bg-[color:var(--panel-strong)] hover:text-[color:var(--text)]',
							]}
						>
							{item.label}
						</a>
					))
				}
				<div class="mt-1 flex items-center justify-between border-t border-[var(--border)] px-3 pt-3">
					<span class="text-xs uppercase tracking-[0.16em] text-[color:var(--text-muted)]">Theme</span>
					<input type="checkbox" id="light-switch-mobile" class="light-switch sr-only" />
					<label
						for="light-switch-mobile"
						class="cursor-pointer rounded-md border border-[var(--border)] bg-[color:var(--panel-strong)] px-2.5 py-1.5 text-xs text-[color:var(--text-muted)]"
					>
						Dark
					</label>
				</div>
			</nav>
		</div>
	</Section>
</header>

<script>
	const initTheme = () => {
		const lightSwitches = Array.from(document.querySelectorAll('.light-switch'));
		const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		const saved = localStorage.getItem('theme');
		const shouldUseDark = saved ? saved === 'dark' : prefersDark;

		document.documentElement.classList.toggle('dark', shouldUseDark);
		lightSwitches.forEach((input) => {
			if (input instanceof HTMLInputElement) {
				input.checked = shouldUseDark;
				if (input.dataset.bound === '1') return;
				input.dataset.bound = '1';
				input.addEventListener('change', () => {
					const enabled = input.checked;
					document.documentElement.classList.toggle('dark', enabled);
					localStorage.setItem('theme', enabled ? 'dark' : 'light');
					document.querySelectorAll('.light-switch').forEach((syncInput) => {
						if (syncInput instanceof HTMLInputElement) {
							syncInput.checked = enabled;
						}
					});
				});
			}
		});
	};

	const initMobileMenu = () => {
		const menu = document.getElementById('mobile-menu');
		const button = document.getElementById('mobile-menu-button');
		if (!(menu instanceof HTMLElement) || !(button instanceof HTMLButtonElement) || button.dataset.bound === '1') {
			return;
		}

		button.dataset.bound = '1';
		button.addEventListener('click', () => {
			const isExpanded = button.getAttribute('aria-expanded') === 'true';
			button.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
			menu.classList.toggle('hidden');
		});
	};

	document.addEventListener('astro:page-load', () => {
		initTheme();
		initMobileMenu();
	});
</script>
