---
import Section from './Section.astro';
---

<Section>
	<div
		class="
            prose prose-lg max-w-none dark:prose-invert
            prose-headings:font-semibold prose-headings:text-[color:var(--text)]
            prose-p:leading-8 prose-p:text-[color:var(--text)]
            prose-a:text-[color:var(--accent)] prose-a:no-underline hover:prose-a:underline
            prose-strong:text-[color:var(--text)] prose-code:rounded prose-code:bg-[color:var(--panel-strong)] prose-code:px-1.5 prose-code:py-0.5
            prose-code:text-[color:var(--accent)] prose-code:before:content-none prose-code:after:content-none
            prose-pre:border prose-pre:border-[var(--border)] prose-pre:bg-[#121212] prose-blockquote:border-l-2 prose-blockquote:border-[color:var(--accent-2)]
            prose-blockquote:text-[color:var(--text-muted)] prose-img:rounded-xl prose-img:border prose-img:border-[var(--border)]
        "
	>
		<slot />
	</div>
</Section>
